---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';

export const prerender = true;

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const tagSet = new Set<string>();
  allPosts.forEach(p => p.data.tags.forEach(t => tagSet.add(t.toLowerCase().replace(/\s+/g, '-'))));
  return Array.from(tagSet).map(tag => ({ params: { tag } }));
}

const { tag } = Astro.params;
const displayTag = tag.replace(/-/g, ' ');

const allPosts = await getCollection('posts');
const posts = allPosts
  .filter(p => p.data.tags.some(t => t.toLowerCase().replace(/\s+/g, '-') === tag))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Base title={`#${displayTag} — Bathroom Storage Ideas`} description={`All posts tagged with "${displayTag}" on Cubby & Sort.`}>
  <Header />

  <main>
    <section class="tag-hero">
      <div class="container">
        <p class="eyebrow"><a href="/">Home</a> / Tags</p>
        <h1 class="tag-title"><span class="tag-hash">#</span>{displayTag}</h1>
        <p class="tag-count">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
      </div>
    </section>

    <section class="posts-section">
      <div class="container">
        {posts.length > 0 ? (
          <div class="posts-grid">
            {posts.map(post => (
              <PostCard
                title={post.data.title}
                description={post.data.description}
                slug={post.slug}
                heroImage={post.data.heroImage}
                heroAlt={post.data.heroAlt}
                category={post.data.category}
                publishDate={post.data.publishDate}
                tags={post.data.tags}
                pinterestDescription={post.data.pinterestDescription}
              />
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <p>No posts found for this tag.</p>
            <a href="/" class="back-link">← Back to home</a>
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .tag-hero {
    background: var(--clr-surface-alt);
    border-bottom: 1px solid var(--clr-border);
    padding-block: var(--space-12);
  }

  .eyebrow { font-size: var(--text-xs); color: var(--clr-text-muted); margin-bottom: var(--space-3); }
  .eyebrow a { color: var(--clr-text-muted); text-decoration: none; }
  .eyebrow a:hover { color: var(--clr-accent); }

  .tag-title {
    font-family: var(--font-display);
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    font-weight: 700;
    color: var(--clr-text);
    margin-bottom: var(--space-2);
    text-transform: capitalize;
  }

  .tag-hash { color: var(--clr-accent); }

  .tag-count { font-size: var(--text-sm); color: var(--clr-text-muted); }

  .posts-section { padding-block: var(--space-12); }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .empty-state { text-align: center; padding-block: var(--space-16); color: var(--clr-text-muted); }
  .back-link { display: inline-block; margin-top: var(--space-4); color: var(--clr-accent); font-weight: 700; text-decoration: none; }

  @media (max-width: 900px) { .posts-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .posts-grid { grid-template-columns: 1fr; } }
</style>
