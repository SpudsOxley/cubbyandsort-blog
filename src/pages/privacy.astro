---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const lastUpdated = 'October 1, 2026';
---

<Base title="Privacy Policy" description="Privacy policy for Cubby & Sort." noindex={true}>
  <Header />
  <main class="static-main">
    <div class="container container--narrow">
      <h1 class="page-title">Privacy Policy</h1>
      <p class="updated">Last updated: {lastUpdated}</p>

      <h2>Information we collect</h2>
      <p>Cubby &amp; Sort does not directly collect personal information. We use third-party services that may collect data as described below.</p>

      <h2>Google Analytics</h2>
      <p>We use Google Analytics to understand how visitors use this site. Google Analytics collects data such as pages visited, time on site, and device type. You can opt out using the <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener">Google Analytics Opt-out Browser Add-on</a>.</p>

      <h2>Google AdSense</h2>
      <p>We display ads through Google AdSense. Google may use cookies to show ads based on your interests. You can manage ad settings at <a href="https://adssettings.google.com" target="_blank" rel="noopener">adssettings.google.com</a>.</p>

      <h2>Affiliate links</h2>
      <p>Some links on this site are affiliate links. Clicking them may set a cookie that tracks whether you make a purchase. We earn a small commission if you do, at no cost to you.</p>

      <h2>Cookies</h2>
      <p>This site uses cookies for analytics and advertising purposes as described above. Most browsers allow you to refuse or delete cookies in your settings.</p>

      <h2>Contact</h2>
      <p>For privacy-related questions, contact us via the <a href="/contact">contact page</a>.</p>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .static-main { padding-block: var(--space-12) var(--space-16); }
  .page-title { font-family: var(--font-display); font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl)); font-weight: 700; color: var(--clr-text); margin-bottom: var(--space-2); }
  .updated { font-size: var(--text-sm); color: var(--clr-text-muted); margin-bottom: var(--space-8); }
  .container--narrow h2 { font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 700; color: var(--clr-text); margin-block: var(--space-8) var(--space-4); }
  .container--narrow p { margin-bottom: var(--space-4); color: var(--clr-text-muted); line-height: 1.7; }
  .container--narrow a { color: var(--clr-accent); }
</style>
