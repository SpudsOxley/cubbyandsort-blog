---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const { title, description, heroImage, heroAlt, category, publishDate, updatedDate, tags, pinterestDescription } = post.data;

const categoryLabels: Record<string, string> = {
  'bathroom-storage': 'Bathroom Storage',
  'small-bathroom-ideas': 'Small Bathrooms',
  'renter-friendly': 'Renter-Friendly',
  'owner-updates': 'Owner Updates',
  'organization-tips': 'Organization Tips',
  'product-reviews': 'Product Reviews',
};

const postUrl = new URL(`/posts/${post.slug}`, Astro.site).href;
const formattedDate = publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const formattedUpdated = updatedDate?.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// Related posts (same category, excluding current)
const allPosts = await getCollection('posts');
const related = allPosts
  .filter(p => p.slug !== post.slug && p.data.category === category)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
---

<Base
  title={title}
  description={description}
  heroImage={heroImage}
  heroAlt={heroAlt}
  type="article"
  publishDate={publishDate}
  updatedDate={updatedDate}
  pinterestDescription={pinterestDescription}
>
  <SchemaOrg
    type="BlogPosting"
    title={title}
    description={description}
    url={postUrl}
    image={heroImage ? new URL(heroImage, Astro.site).href : undefined}
    publishDate={publishDate}
    updatedDate={updatedDate}
  />

  <Header />

  <main class="post-main">
    <div class="container">
      <div class="post-layout">

        <!-- Article -->
        <article class="post-article">

          <!-- Breadcrumb -->
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <ol>
              <li><a href="/">Home</a></li>
              <li><a href={`/category/${category}`}>{categoryLabels[category] ?? category}</a></li>
              <li aria-current="page">{title}</li>
            </ol>
          </nav>

          <!-- Hero image -->
          {heroImage && (
            <div class="post-hero-wrap">
              <img
                src={heroImage}
                alt={heroAlt ?? title}
                class="post-hero-img"
                width="800"
                height="1200"
                loading="eager"
                decoding="async"
              />
              <!-- Pinterest Save button on hero -->
              <button
                class="hero-pin-btn"
                aria-label={`Save to Pinterest`}
                onclick={`window.open('https://pinterest.com/pin/create/button/?url='+encodeURIComponent('${postUrl}')+'&media='+encodeURIComponent('${heroImage ? new URL(heroImage, Astro.site).href : ''}')+'&description='+encodeURIComponent('${(pinterestDescription ?? description).replace(/'/g, "\\'")}'),'_blank','width=750,height=550')`}
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
                Save to Pinterest
              </button>
            </div>
          )}

          <!-- Post header -->
          <header class="post-header">
            <div class="post-meta">
              <a href={`/category/${category}`} class="post-category">{categoryLabels[category] ?? category}</a>
              <time datetime={publishDate.toISOString()}>{formattedDate}</time>
              {updatedDate && <span class="updated">Updated {formattedUpdated}</span>}
            </div>
            <h1 class="post-title">{title}</h1>
            <p class="post-description">{description}</p>

            {tags.length > 0 && (
              <div class="post-tags">
                {tags.map(tag => (
                  <a href={`/tag/${tag.toLowerCase().replace(/\s+/g, '-')}`} class="tag">{tag}</a>
                ))}
              </div>
            )}
          </header>

          <!-- Ad slot — above content -->
          <div class="ad-slot" aria-label="Advertisement">Advertisement</div>

          <!-- Post content -->
          <div class="post-content">
            <Content />
          </div>

          <!-- Ad slot — below content -->
          <div class="ad-slot" aria-label="Advertisement">Advertisement</div>

          <!-- Share row -->
          <div class="share-row">
            <span class="share-label">Save this idea:</span>
            <button
              class="share-btn share-btn--pinterest"
              onclick={`window.open('https://pinterest.com/pin/create/button/?url='+encodeURIComponent('${postUrl}')+'&media='+encodeURIComponent('${heroImage ? new URL(heroImage, Astro.site).href : ''}')+'&description='+encodeURIComponent('${(pinterestDescription ?? description).replace(/'/g, "\\'")}'),'_blank','width=750,height=550')`}
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
              Save to Pinterest
            </button>
          </div>

        </article>

        <!-- Sidebar -->
        <aside class="post-sidebar">
          <div class="sidebar-sticky">

            <!-- Ad slot -->
            <div class="ad-slot ad-slot--sidebar" aria-label="Advertisement">Advertisement</div>

            <!-- Categories widget -->
            <div class="widget">
              <h3 class="widget-title">Browse Topics</h3>
              <ul class="widget-list">
                <li><a href="/category/bathroom-storage">🪣 Bathroom Storage</a></li>
                <li><a href="/category/renter-friendly">🔑 Renter-Friendly</a></li>
                <li><a href="/category/small-bathroom-ideas">📐 Small Bathrooms</a></li>
                <li><a href="/category/owner-updates">🔨 Owner Updates</a></li>
                <li><a href="/category/organization-tips">✨ Organization Tips</a></li>
                <li><a href="/category/product-reviews">⭐ Product Reviews</a></li>
              </ul>
            </div>

            <!-- Ad slot -->
            <div class="ad-slot ad-slot--sidebar" aria-label="Advertisement">Advertisement</div>

            <!-- Pinterest CTA widget -->
            <div class="widget widget--pinterest">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="#E60023" aria-hidden="true"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
              <p>Save ideas for later on Pinterest</p>
              <a href="https://pinterest.com" target="_blank" rel="noopener" class="widget-pin-btn">Follow Us</a>
            </div>

          </div>
        </aside>

      </div>

      <!-- Related posts -->
      {related.length > 0 && (
        <section class="related-posts">
          <h2 class="section-title">More {categoryLabels[category] ?? ''} Ideas</h2>
          <div class="related-grid">
            {related.map(p => (
              <a href={`/posts/${p.slug}`} class="related-card">
                {p.data.heroImage && (
                  <div class="related-img-wrap">
                    <img src={p.data.heroImage} alt={p.data.heroAlt ?? p.data.title} loading="lazy" decoding="async" />
                  </div>
                )}
                <div class="related-body">
                  <p class="related-cat">{categoryLabels[p.data.category] ?? p.data.category}</p>
                  <h3 class="related-title">{p.data.title}</h3>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </main>

  <Footer />
</Base>

<style>
  .post-main { padding-block: var(--space-8) var(--space-16); }

  .post-layout {
    display: grid;
    grid-template-columns: 1fr var(--sidebar-w);
    gap: var(--space-12);
    align-items: start;
  }

  /* Breadcrumb */
  .breadcrumb { margin-bottom: var(--space-6); }
  .breadcrumb ol {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: var(--space-2);
    font-size: var(--text-sm); color: var(--clr-text-muted);
  }
  .breadcrumb li + li::before { content: '/'; margin-right: var(--space-2); }
  .breadcrumb a { color: var(--clr-text-muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--clr-accent); }

  /* Hero image */
  .post-hero-wrap {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: var(--space-8);
    max-height: 520px;
  }
  .post-hero-img {
    width: 100%; height: 100%;
    object-fit: cover;
    aspect-ratio: 4/3;
  }

  .hero-pin-btn {
    position: absolute; bottom: var(--space-4); right: var(--space-4);
    background: #E60023; color: white; border: none;
    padding: var(--space-2) var(--space-4); border-radius: var(--radius-sm);
    font-size: var(--text-sm); font-weight: 700; font-family: var(--font-body);
    cursor: pointer; display: flex; align-items: center; gap: var(--space-2);
    transition: background 0.15s;
  }
  .hero-pin-btn:hover { background: #c0001d; }

  /* Post header */
  .post-meta {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: var(--space-3); margin-bottom: var(--space-4);
    font-size: var(--text-sm); color: var(--clr-text-muted);
  }
  .post-category {
    font-size: var(--text-xs); font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--clr-accent); background: var(--clr-accent-soft);
    padding: 3px 8px; border-radius: 4px; text-decoration: none;
  }
  .updated { font-style: italic; }

  .post-title {
    font-family: var(--font-display);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    font-weight: 700; line-height: 1.15;
    color: var(--clr-text); margin-bottom: var(--space-4);
  }

  .post-description {
    font-size: var(--text-lg); color: var(--clr-text-muted);
    line-height: 1.6; max-width: 60ch; margin-bottom: var(--space-4);
  }

  .post-tags {
    display: flex; flex-wrap: wrap; gap: var(--space-2);
    margin-bottom: var(--space-6);
  }
  .tag {
    font-size: var(--text-xs); color: var(--clr-tag-text);
    background: var(--clr-tag-bg); padding: 3px 8px;
    border-radius: 4px; text-decoration: none;
  }
  .tag:hover { background: var(--clr-accent-soft); color: var(--clr-accent); }

  /* Post content */
  .post-content {
    font-size: var(--text-base); line-height: 1.8;
    max-width: 68ch;
  }
  .post-content :global(h2) {
    font-family: var(--font-display); font-size: var(--text-2xl);
    font-weight: 700; color: var(--clr-text);
    margin-block: var(--space-8) var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--clr-accent-soft);
  }
  .post-content :global(h3) {
    font-family: var(--font-display); font-size: var(--text-xl);
    font-weight: 700; color: var(--clr-text);
    margin-block: var(--space-6) var(--space-3);
  }
  .post-content :global(p) { margin-bottom: var(--space-4); }
  .post-content :global(ul), .post-content :global(ol) {
    padding-left: var(--space-6); margin-bottom: var(--space-4);
  }
  .post-content :global(li) { margin-bottom: var(--space-2); }
  .post-content :global(strong) { color: var(--clr-text); font-weight: 700; }
  .post-content :global(a) { color: var(--clr-accent); }
  .post-content :global(img) {
    border-radius: var(--radius-md); margin-block: var(--space-6);
    box-shadow: var(--shadow-md);
  }
  .post-content :global(blockquote) {
    border-left: 3px solid var(--clr-accent);
    padding-left: var(--space-4); margin-left: 0;
    color: var(--clr-text-muted); font-style: italic;
  }

  /* Share row */
  .share-row {
    display: flex; align-items: center; gap: var(--space-4);
    padding-block: var(--space-6);
    border-top: 1px solid var(--clr-border);
    margin-top: var(--space-8);
  }
  .share-label { font-size: var(--text-sm); font-weight: 700; color: var(--clr-text-muted); }
  .share-btn {
    display: inline-flex; align-items: center; gap: var(--space-2);
    border: none; cursor: pointer; font-family: var(--font-body);
    font-size: var(--text-sm); font-weight: 700;
    padding: var(--space-2) var(--space-4); border-radius: var(--radius-sm);
    transition: opacity 0.15s;
  }
  .share-btn--pinterest { background: #E60023; color: white; }
  .share-btn--pinterest:hover { opacity: 0.85; }

  /* Sidebar */
  .sidebar-sticky { position: sticky; top: calc(env(safe-area-inset-top, 0px) + 80px); }
  .ad-slot--sidebar { min-height: 250px; }

  .widget {
    background: var(--clr-surface);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    margin-bottom: var(--space-4);
  }
  .widget-title {
    font-family: var(--font-display); font-size: var(--text-base);
    font-weight: 700; color: var(--clr-text); margin-bottom: var(--space-3);
  }
  .widget-list {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-direction: column; gap: var(--space-2);
  }
  .widget-list a {
    font-size: var(--text-sm); color: var(--clr-text-muted);
    text-decoration: none; transition: color 0.15s;
  }
  .widget-list a:hover { color: var(--clr-accent); }

  .widget--pinterest {
    background: #fff5f5;
    border-color: #fecdd3;
    text-align: center;
    display: flex; flex-direction: column;
    align-items: center; gap: var(--space-3);
  }
  .widget--pinterest p { font-size: var(--text-sm); color: var(--clr-text-muted); margin: 0; }
  .widget-pin-btn {
    background: #E60023; color: white; text-decoration: none;
    font-size: var(--text-sm); font-weight: 700;
    padding: var(--space-2) var(--space-4); border-radius: var(--radius-sm);
  }
  .widget-pin-btn:hover { background: #c0001d; color: white; }

  /* Related posts */
  .related-posts { padding-top: var(--space-12); border-top: 1px solid var(--clr-border); margin-top: var(--space-12); }
  .section-title {
    font-family: var(--font-display); font-size: var(--text-2xl);
    font-weight: 700; color: var(--clr-text); margin-bottom: var(--space-6);
  }
  .related-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6);
  }
  .related-card {
    text-decoration: none; border-radius: var(--radius-md);
    overflow: hidden; background: var(--clr-surface);
    border: 1px solid var(--clr-border); transition: box-shadow 0.2s, transform 0.2s;
  }
  .related-card:hover { box-shadow: var(--shadow-hover); transform: translateY(-2px); }
  .related-img-wrap { aspect-ratio: 3/2; overflow: hidden; }
  .related-img-wrap img { width: 100%; height: 100%; object-fit: cover; }
  .related-body { padding: var(--space-3) var(--space-4); }
  .related-cat {
    font-size: var(--text-xs); font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--clr-accent); margin-bottom: var(--space-1);
  }
  .related-title {
    font-family: var(--font-display); font-size: var(--text-base);
    font-weight: 700; color: var(--clr-text); line-height: 1.3;
  }

  @media (max-width: 900px) {
    .post-layout { grid-template-columns: 1fr; }
    .post-sidebar { display: none; }
    .related-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .related-grid { grid-template-columns: 1fr; }
  }
</style>
