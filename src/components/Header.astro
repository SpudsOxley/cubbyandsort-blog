---
interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;

const nav = [
  { label: 'Home', href: '/' },
  { label: 'Bathroom Storage', href: '/category/bathroom-storage' },
  { label: 'Renter-Friendly', href: '/category/renter-friendly' },
  { label: 'Small Bathrooms', href: '/category/small-bathroom-ideas' },
  { label: 'About', href: '/about' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Cubby & Sort — Home">
      <span class="brand-icon" aria-hidden="true">🛁</span>
      <span class="brand-text">
        <span class="brand-name">Cubby <span class="brand-amp">&amp;</span> Sort</span>
        <span class="brand-tagline">Small Bathroom, Big Ideas</span>
      </span>
    </a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="main-nav" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>

    <nav id="main-nav" class="main-nav" aria-label="Main navigation">
      <ul role="list">
        {nav.map(item => (
          <li>
            <a
              href={item.href}
              class:list={['nav-link', { active: currentPath === item.href || currentPath.startsWith(item.href + '/') && item.href !== '/' }]}
              aria-current={currentPath === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 100;
    background: var(--clr-surface);
    border-bottom: 1px solid var(--clr-border);
    box-shadow: var(--shadow-sm);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }

  /* Brand */
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-icon {
    font-size: 1.5rem;
    line-height: 1;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--clr-text);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .brand-amp {
    color: var(--clr-accent);
  }

  .brand-tagline {
    font-size: var(--text-xs);
    color: var(--clr-text-muted);
    letter-spacing: 0.05em;
    font-weight: 400;
  }

  /* Nav */
  .main-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-1);
    align-items: center;
    flex-wrap: wrap;
  }

  .nav-link {
    display: block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
    color: var(--clr-text-muted);
    border-radius: var(--radius-sm);
    transition: color 0.15s, background 0.15s;
    white-space: nowrap;
    letter-spacing: 0.01em;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--clr-accent);
    background: var(--clr-accent-soft);
  }

  /* Mobile toggle */
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-2);
    border-radius: var(--radius-sm);
  }

  .nav-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--clr-text);
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }

  /* Mobile nav */
  @media (max-width: 768px) {
    .nav-toggle { display: flex; }

    .main-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--clr-surface);
      border-bottom: 1px solid var(--clr-border);
      padding: var(--space-4);
      box-shadow: var(--shadow-md);
    }

    .main-nav.open { display: block; }

    .main-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-1);
    }

    .nav-link {
      font-size: var(--text-base);
      padding: var(--space-3) var(--space-4);
    }
  }
</style>

<script>
  const toggle = document.querySelector('.nav-toggle') as HTMLButtonElement;
  const nav = document.querySelector('.main-nav') as HTMLElement;

  toggle?.addEventListener('click', () => {
    const isOpen = nav.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(isOpen));
  });
</script>
