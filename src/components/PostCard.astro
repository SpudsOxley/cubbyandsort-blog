---
interface Props {
  title: string;
  description: string;
  slug: string;
  heroImage?: string;
  heroAlt?: string;
  category: string;
  publishDate: Date;
  tags?: string[];
  featured?: boolean;
  pinterestDescription?: string;
  size?: 'default' | 'large';
}

const {
  title,
  description,
  slug,
  heroImage,
  heroAlt,
  category,
  publishDate,
  tags = [],
  featured = false,
  pinterestDescription,
  size = 'default',
} = Astro.props;

const categoryLabels: Record<string, string> = {
  'bathroom-storage': 'Bathroom Storage',
  'small-bathroom-ideas': 'Small Bathrooms',
  'renter-friendly': 'Renter-Friendly',
  'owner-updates': 'Owner Updates',
  'organization-tips': 'Organization Tips',
  'product-reviews': 'Product Reviews',
};

const formattedDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<article class:list={['post-card', size === 'large' && 'post-card--large', featured && 'post-card--featured']}>
  <a href={`/posts/${slug}`} class="card-image-link" tabindex="-1" aria-hidden="true">
    {heroImage ? (
      <div class="card-image-wrap">
        <img
          src={heroImage}
          alt={heroAlt ?? title}
          loading="lazy"
          decoding="async"
          class="card-image"
        />
        {/* Pinterest Save button */}
        <button
          class="pin-btn"
          aria-label={`Save "${title}" to Pinterest`}
          data-pin-do="buttonPin"
          data-pin-href={`https://cubbyandsort.com/posts/${slug}`}
          data-pin-media={heroImage}
          data-pin-description={pinterestDescription ?? description}
          onclick={`event.preventDefault(); event.stopPropagation(); window.open('https://pinterest.com/pin/create/button/?url='+encodeURIComponent('https://cubbyandsort.com/posts/${slug}')+'&media='+encodeURIComponent('${heroImage}')+'&description='+encodeURIComponent('${(pinterestDescription ?? description).replace(/'/g, "\\'")}'),'_blank','width=750,height=550')`}
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/>
          </svg>
          Save
        </button>
      </div>
    ) : (
      <div class="card-image-placeholder">
        <span aria-hidden="true">🛁</span>
      </div>
    )}
  </a>

  <div class="card-body">
    <div class="card-meta">
      <a href={`/category/${category}`} class="card-category">{categoryLabels[category] ?? category}</a>
      <time datetime={publishDate.toISOString()} class="card-date">{formattedDate}</time>
    </div>

    <h2 class="card-title">
      <a href={`/posts/${slug}`}>{title}</a>
    </h2>

    <p class="card-desc">{description}</p>

    {tags.length > 0 && (
      <div class="card-tags">
        {tags.slice(0, 3).map(tag => (
          <a href={`/tag/${tag.toLowerCase().replace(/\s+/g, '-')}`} class="tag">{tag}</a>
        ))}
      </div>
    )}

    <a href={`/posts/${slug}`} class="card-read-more" aria-label={`Read: ${title}`}>
      Read more →
    </a>
  </div>
</article>

<style>
  .post-card {
    background: var(--clr-surface);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .post-card:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-2px);
  }

  /* Image */
  .card-image-link { display: block; }

  .card-image-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: 2 / 3; /* Pinterest-native tall ratio */
    background: var(--clr-surface-alt);
  }

  .post-card--large .card-image-wrap {
    aspect-ratio: 4 / 3;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .post-card:hover .card-image {
    transform: scale(1.03);
  }

  .card-image-placeholder {
    aspect-ratio: 2 / 3;
    background: var(--clr-surface-alt);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
  }

  /* Pinterest save button */
  .pin-btn {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    background: #E60023;
    color: white;
    border: none;
    border-radius: var(--radius-sm);
    padding: 5px 10px;
    font-size: 12px;
    font-weight: 700;
    font-family: var(--font-body);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 5px;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.18s, transform 0.18s;
  }

  .post-card:hover .pin-btn,
  .post-card:focus-within .pin-btn {
    opacity: 1;
    transform: translateY(0);
  }

  .pin-btn:hover { background: #c0001d; }

  /* Card body */
  .card-body {
    padding: var(--space-4) var(--space-5) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .card-category {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--clr-accent);
    text-decoration: none;
    background: var(--clr-accent-soft);
    padding: 3px 8px;
    border-radius: 4px;
  }

  .card-category:hover { color: var(--clr-accent-dark); }

  .card-date {
    font-size: var(--text-xs);
    color: var(--clr-text-muted);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.25;
    margin: 0;
  }

  .post-card--large .card-title {
    font-size: var(--text-2xl);
  }

  .card-title a {
    color: var(--clr-text);
    text-decoration: none;
  }

  .card-title a:hover { color: var(--clr-accent); }

  .card-desc {
    font-size: var(--text-sm);
    color: var(--clr-text-muted);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag {
    font-size: var(--text-xs);
    color: var(--clr-tag-text);
    background: var(--clr-tag-bg);
    padding: 3px 8px;
    border-radius: 4px;
    text-decoration: none;
    transition: background 0.15s;
  }

  .tag:hover {
    background: var(--clr-accent-soft);
    color: var(--clr-accent);
  }

  .card-read-more {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--clr-accent);
    text-decoration: none;
    margin-top: auto;
  }

  .card-read-more:hover { color: var(--clr-accent-dark); }
</style>
