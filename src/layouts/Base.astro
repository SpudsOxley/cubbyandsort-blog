---
import { getEntry } from 'astro:content';

const settings = await getEntry('settings' as any, 'site' as any).catch(() => null);
const siteName = settings?.data?.siteName ?? 'Cubby & Sort';
const siteTagline = settings?.data?.tagline ?? 'Small Bathroom, Big Ideas';
const siteDescription = settings?.data?.description ?? 'Bathroom storage and organization ideas for renters and owners.';
const adsenseId = settings?.data?.googleAdsenseId ?? '';

interface Props {
  title?: string;
  description?: string;
  heroImage?: string;
  heroAlt?: string;
  canonical?: string;
  type?: 'website' | 'article';
  publishDate?: Date;
  updatedDate?: Date;
  pinterestDescription?: string;
  noindex?: boolean;
}

const {
  title,
  description = siteDescription,
  heroImage,
  heroAlt,
  canonical,
  type = 'website',
  publishDate,
  updatedDate,
  pinterestDescription,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${siteName}` : `${siteName} — ${siteTagline}`;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImage = heroImage
  ? new URL(heroImage, Astro.site).href
  : new URL('/og-default.jpg', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={siteName} />

    <!-- Pinterest -->
    <meta name="pinterest:description" content={pinterestDescription ?? description} />
    {heroImage && <meta name="pinterest:media" content={new URL(heroImage, Astro.site).href} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Article dates -->
    {publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />

    <!-- Google AdSense -->
    {adsenseId && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseId}`} crossorigin="anonymous"></script>
    )}

    <!-- Global styles -->
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <slot />
  </body>
</html>
